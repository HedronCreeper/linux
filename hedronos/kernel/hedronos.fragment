# HedronOS kernel configuration — generated by hedronos/tools/gen-defconfig.py.
#
# SPDX-License-Identifier: MIT
#
# Do not hand-edit: change the spec (hedronos/kernel/defconfig-spec.py) and regenerate.
# Every symbol here was found in this tree's Kconfig files; the generator drops names
# it cannot find, and --require turns those drops into a build error.


# --------------------------------------------------------------------------
# build, IPC and the syscall surface we depend on
# --------------------------------------------------------------------------
# DEBUG_INFO_BTF: sched_ext and BPF structural probes are impossible without BTF
CONFIG_DEBUG_INFO_BTF=y
# DEBUG_INFO_BTF_MODULES: so amdgpu/xe as modules are also probeable
CONFIG_DEBUG_INFO_BTF_MODULES=y
# FTRACE_SYSCALLS: the replay tool attributes a stutter to a syscall, not to 'the kernel'
CONFIG_FTRACE_SYSCALLS=y
# HWLAT_TRACER: hedron-latency hwlat mode
CONFIG_HWLAT_TRACER=y
# TIMERLAT_TRACER: hedron-latency timerlat mode: per-CPU, with a deadline
CONFIG_TIMERLAT_TRACER=y
# OSNOISE_TRACER: run this while the machine idles to prove the 1 ms frame budget is safe
CONFIG_OSNOISE_TRACER=y
# MEM_ALLOC_PROFILING: who allocated the memory, which is the answer to 'why is VRAM-backed RAM full'
CONFIG_MEM_ALLOC_PROFILING=y
# KEXEC: crash dumps from a machine that only faults under load
CONFIG_KEXEC=y
# KEXEC_FILE: signature-verified kexec, so lockdown and kdump can coexist
CONFIG_KEXEC_FILE=y
# CRASH_DUMP: the dump-capture kernel side
CONFIG_CRASH_DUMP=y
# FRAME_WARN: a frame that deep is a stack-overflow waiting for a deep reclaim path
CONFIG_FRAME_WARN=2048
# KALLSYMS_ALL: perf and the HUD need per-CPU and __init symbols
CONFIG_KALLSYMS_ALL=y

# --------------------------------------------------------------------------
# latency: tickless, 300 Hz, no RCU callbacks on the game CPUs
# --------------------------------------------------------------------------
# PREEMPT_RT: the -rt flavour: threading models, no 'preempt_disable for a page fault'
CONFIG_PREEMPT_RT=y
# PREEMPT_COUNT: needed by gamescope's pipelined present for accurate frame pacing
CONFIG_PREEMPT_COUNT=y
CONFIG_HIGH_RES_TIMERS=y
# NO_HZ_FULL: tickless on the isolated cores; the game core must not be woken 300x/s
CONFIG_NO_HZ_FULL=y
# RCU_NOCB_CPU: offload RCU callbacks off the gaming cores (hedron-tune sets the cpumask)
CONFIG_RCU_NOCB_CPU=y
# RCU_BOOST: so a short RT section cannot be delayed by a long rcu_read_lock
CONFIG_RCU_BOOST=y
# RCU_BOOST_DELAY: boost the grace-period kthread within half a ms of need
CONFIG_RCU_BOOST_DELAY=500
# IRQ_TIME_ACCOUNTING: per-softirq time, which hedron-tune uses to spot interrupt storms
CONFIG_IRQ_TIME_ACCOUNTING=y
# IRQ_FORCED_THREADING: implicit with RT, spelled out because a regression here is audible
CONFIG_IRQ_FORCED_THREADING=y

# --------------------------------------------------------------------------
# scheduler: sched_ext, core scheduling, group identity
# --------------------------------------------------------------------------
# SCHED_CORE: core scheduling for anti-cheat-safe pairing of game and overlay threads
CONFIG_SCHED_CORE=y
# SCHED_SMT: SMT-aware balancing so the second hyperthread does not steal frame time
CONFIG_SCHED_SMT=y
# RT_GROUP_SCHED: off: a game session owns its cpu.max and must not share a group quota
# CONFIG_RT_GROUP_SCHED is not set
# CGROUP_SCHED: the gamescope/Steam slices depend on the cpu controller
CONFIG_CGROUP_SCHED=y
# SCHEDSTATS: run latency statistics per cgroup for the vitals HUD
CONFIG_SCHEDSTATS=y
# SCHED_INFO: delayacct: the numbers hedron-latency reports in ms
CONFIG_SCHED_INFO=y

# --------------------------------------------------------------------------
# power: governors, RAPL, thermal, suspend and hibernation
# --------------------------------------------------------------------------
# CPU_FREQ_GOV_PERFORMANCE: governor built in, not as a module, so a cold boot never falls back to powersave
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
# CPU_FREQ_GOV_POWERSAVE: the battery profile on a handheld
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
# CPU_IDLE_GOV_TEO: the only idle governor worth having on a Deck-class machine
CONFIG_CPU_IDLE_GOV_TEO=y
# INTEL_IDLE: C-state table for the x86 handhelds
CONFIG_INTEL_IDLE=y
# AMD_PMC: s2idle on AMD, which is every current handheld
CONFIG_AMD_PMC=y
# X86_AMD_PSTATE_UT: the debug module hedron-doctor uses to read a pstate transition
CONFIG_X86_AMD_PSTATE_UT=m
# POWERCAP: RAPL: what 'how many watts is this box pulling' means on x86
CONFIG_POWERCAP=y
# INTEL_RAPL: package/DRAM/powerwell counters
CONFIG_INTEL_RAPL=m
CONFIG_AMD_HSMP=y

# --------------------------------------------------------------------------
# memory: zswap, LRU gen, huge pages, zero-on-alloc
# --------------------------------------------------------------------------
# ZSWAP: compress before swapping: a 32 GB machine can hold two games and a browser
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
# LRU_GEN: the multi-generational LRU keeps a game's working set out of the evict list
CONFIG_LRU_GEN=y
# LRU_GEN_ENABLED: on by default for our users, tunable via /sys/kernel/mm/lru_gen
CONFIG_LRU_GEN_ENABLED=y
# TRANSPARENT_HUGEPAGE_ALWAYS: game allocators are big and linear; defrag=always is the tuning daemon's job
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
# COMPACTION: without it THP is a lottery
CONFIG_COMPACTION=y
# MITIGATION_PAGE_TABLE_ISOLATION: left on: Meltdown mitigation costs ~2% and a customer's bank account
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
# INIT_ON_ALLOC_DEFAULT_ON: cheap hardening for a machine that runs untrusted anti-cheat ring-0
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y

# --------------------------------------------------------------------------
# security: lockdown, module signing, verity, TPM, keyring
# --------------------------------------------------------------------------
# CRYPTO_USER_API: so userspace (LUKS, WireGuard tests) can use the hardware path
CONFIG_CRYPTO_USER_API=m
# IMA: integrity measurement, the half of Secure Boot that gives you a log
CONFIG_IMA=y
# INTEGRITY_PLATFORM_KEYRING: MOK enrolment for a user who signed their own driver
CONFIG_INTEGRITY_PLATFORM_KEYRING=y
# TEE: OP-TEE on the ARM handhelds
CONFIG_TEE=y

# --------------------------------------------------------------------------
# graphics: amdgpu, i915, xe, nova, nouveau, radeon, kms
# --------------------------------------------------------------------------
# DRM_XE: Intel Arc on the new driver, as a module so the -uc image can boot anything
CONFIG_DRM_XE=m
# DRM_NOUVEAU: GDDR5-era NVIDIA: no kernel driver support for those, so Nouveau is the plan
CONFIG_DRM_NOUVEAU=m
# DRM_VMWGFX: so the -uc image and a VM on it behave the same
CONFIG_DRM_VMWGFX=y
# DRM_VIRTIO_GPU: the same reason, on KVM
CONFIG_DRM_VIRTIO_GPU=y
# DRM_BOCHS: QEMU default display: without it a rehearsal VM has no console
CONFIG_DRM_BOCHS=y
# DRM_AST: every server-class board's BMC output
CONFIG_DRM_AST=y
# DRM_SIMPLEDRM: the handshake that keeps a splash on screen until the real driver loads
CONFIG_DRM_SIMPLEDRM=y
# DRM_CLIENT: so a framebuffer console exists over DRM rather than beside it
CONFIG_DRM_CLIENT=y
# DRM_TTM: the VRAM manager amdgpu/nouveau/xe all share
CONFIG_DRM_TTM=y
CONFIG_DRM_GPUVM=y
# IOMMU_SVA: shared virtual addressing, which is how compute and graphics share one address space
CONFIG_IOMMU_SVA=y
# PCI_PRI: page request interface, required by SVA
CONFIG_PCI_PRI=y
# PCI_PASID: and its partner
CONFIG_PCI_PASID=y
# PCI_ATS: address translation services
CONFIG_PCI_ATS=y

# --------------------------------------------------------------------------
# audio: HDA (including the codec list), SOF, USB audio, OSS compat
# --------------------------------------------------------------------------
# SND_HDA_INTEL: built in, not modular: the -uc image must have audio before the drivers load
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_TEGRA=y
# SND_USB_AUDIO: USB headsets are the majority of gaming headsets
CONFIG_SND_USB_AUDIO=y
# SND_SOC_SOF_INTEL_HIFI_EP_IPC: SOFA/SOF on recent Intel laptop codecs
CONFIG_SND_SOC_SOF_INTEL_HIFI_EP_IPC=m
# SND_SEQ_DUMMY: so a DAW and a launcher can both own MIDI
CONFIG_SND_SEQ_DUMMY=m
# SND_SOC_TOPOLOGY: SOF machine files load a topology; renamed from SND_TOPOLOGY
CONFIG_SND_SOC_TOPOLOGY=y

# --------------------------------------------------------------------------
# input and HID: controllers, wheels, pads, touch, the handheld keys
# --------------------------------------------------------------------------
# TOUCHSCREEN_GOODIX: and on most of the others
CONFIG_TOUCHSCREEN_GOODIX=y
# TOUCHSCREEN_EDT_FT5X06: Steam Deck LCD digitizer
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
# HID_PLAYSTATION: DualSense over USB and BT, including the gyro
CONFIG_HID_PLAYSTATION=y
# JOYSTICK_XPAD: XInput controllers
CONFIG_JOYSTICK_XPAD=y
# JOYSTICK_XPAD_FF: rumble
CONFIG_JOYSTICK_XPAD_FF=y
# JOYSTICK_XPAD_LEDS: the guide-button light, which players use to identify their pad
CONFIG_JOYSTICK_XPAD_LEDS=y
# SERIO_I8042: the PS/2 port is how a lot of BIOS-era keyboards still arrive
CONFIG_SERIO_I8042=y
# KEYBOARD_GPIO: Deck/ROG-style buttons (guide, QAM, volume) are GPIOs
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_ADC=y
# INPUT_JOYDEV: legacy /dev/js for the games that predate SDL's evdev path
CONFIG_INPUT_JOYDEV=y

# --------------------------------------------------------------------------
# networking: BBR, wireguard, nftables, wifi, bluetooth
# --------------------------------------------------------------------------
# XDP_SOCKETS: XDP sockets, for the low-latency path and for replay capture
CONFIG_XDP_SOCKETS=y
# NET_DEVMEM: device memory: zero-copy between a NIC/GPU and a socket
CONFIG_NET_DEVMEM=y
# WIREGUARD: a LAN over a café network is a normal thing for a laptop gamer to want
CONFIG_WIREGUARD=y
# INET_DIAG: ss(8), which hedron-doctor uses to spot a stuck peer
CONFIG_INET_DIAG=y
# NET_SCH_FQ_CODEL: the default qdisc is what keeps a download from costing 40 ms of ping
CONFIG_NET_SCH_FQ_CODEL=y
# NET_SCH_CAKE: the alternative, for the users who ask
CONFIG_NET_SCH_CAKE=m
# MAC80211_MESH: -uc image: a LAN party is a mesh
CONFIG_MAC80211_MESH=y
# BT_HIDP: Bluetooth HID devices over the profile some controllers insist on
CONFIG_BT_HIDP=y

# --------------------------------------------------------------------------
# filesystems: btrfs (the install default), ext4, xfs, f2fs, NTFS3, network
# --------------------------------------------------------------------------
# BTRFS_FS: built in: the install default, with subvolumes and zstd, is not optional
CONFIG_BTRFS_FS=y
# BTRFS_ASSERT: a corrupted FS should stop rather than scribble over a save-game directory
CONFIG_BTRFS_ASSERT=y
# F2FS_FS: the SD-card and eMMC case
CONFIG_F2FS_FS=y
# EXFAT_FS: the format every camera and capture card formats its media as
CONFIG_EXFAT_FS=y
# UDF_FS: reading a pressed disc or a camera card
CONFIG_UDF_FS=y
# NLS_UTF8: and the code pages a Windows dual-boot leaves on a shared partition
CONFIG_NLS_UTF8=y
# 9P_FS: shared folders with a VM, which is how a rehearsal sees the files
CONFIG_9P_FS=y
# NETWORK_FILESYSTEMS: explicit, because a defconfig with no network fs is a confusing support ticket
CONFIG_NETWORK_FILESYSTEMS=y
# AUTOFS_FS: systemd's mount machinery and home directories depend on it
CONFIG_AUTOFS_FS=y
# FSCACHE: the read-side cache for network homes
CONFIG_FSCACHE=y

# --------------------------------------------------------------------------
# block: NVMe, AHCI, RAID, dm, DAX
# --------------------------------------------------------------------------
# BLK_DEV_LOOP: the installer mounts a squashfs and a loop device, so built in
CONFIG_BLK_DEV_LOOP=y
# BLK_DEV_NBD: network block device, for a rehearsal that streams a disk image
CONFIG_BLK_DEV_NBD=m
# BLK_DEV_RAM: an initrd that needs a second RAM disk (mkinitcpio hooks)
CONFIG_BLK_DEV_RAM=y
# DM_VERITY: the read-only OSTree-style fallback root, if we ever ship one
CONFIG_DM_VERITY=y
# EROFS_FS: the compressed read-only alternative to squashfs for /live
CONFIG_EROFS_FS=y
# ZRAM_WRITEBACK: spill compressed pages to a swapfile instead of recompressing forever
CONFIG_ZRAM_WRITEBACK=y
# BLK_WBT: writeback throttling: without it a copy costs you 30 ms of input lag
CONFIG_BLK_WBT=y

# --------------------------------------------------------------------------
# platform drivers: vendor laptops, handhelds, tablets
# --------------------------------------------------------------------------
# AMD_PMF: the PMF/MP2 telemetry that powers the automatic fan profiles
CONFIG_AMD_PMF=y
# INTEL_HID_EVENT: hybrid-button events on Intel reference designs
CONFIG_INTEL_HID_EVENT=m
# ASUS_WMI: ROG Ally / Z13 fan and brightness controls
CONFIG_ASUS_WMI=m

# --------------------------------------------------------------------------
# sensors and watchdogs: what hedron-vitals reads
# --------------------------------------------------------------------------
# SENSORS_K8TEMP: the temperature source on every AMD handheld and desktop
CONFIG_SENSORS_K8TEMP=m
# SENSORS_K10TEMP: and its newer sibling
CONFIG_SENSORS_K10TEMP=m
# SENSORS_CORETEMP: Intel package temperature
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_AMC6821=y
# HWMON_VID: rail voltages, which is what a user means by 'is my PSU sagging'
CONFIG_HWMON_VID=y
