# Sourced by /etc/default/grub and by /etc/grub.d/00_header. SPDX-License-Identifier: MIT
# The kernel command line the distro is opinionated about; per-GPU flags are appended by
# hedron-drivers (it owns graphics parameters, this file owns scheduling and quiet).
GRUB_TIMEOUT=3
GRUB_DISTRIBUTOR="HedronOS"
GRUB_DEFAULT=saved
GRUB_SAVEDEFAULT=true
GRUB_BACKGROUND=/usr/share/hedron/wallpapers/duality.svg
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3 rd.systemd.show_status=auto rd.udev.log_priority=3 nowatchdog mitigations=auto,nosmt nosoftlockup"
GRUB_CMDLINE_LINUX=""
GRUB_DISABLE_RECOVERY=false
GRUB_DISABLE_SUBMENU=y
GRUB_TERMINAL_OUTPUT=gfxterm
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_THEME=/usr/share/hedron/grub/theme.txt
GRUB_COLOR_NORMAL="light-gray/black"
GRUB_COLOR_HIGHLIGHT="green/black"
