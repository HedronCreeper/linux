# SPDX-License-Identifier: MIT
[Unit]
Description=HedronOS driver planner daemon (on-demand, socket activated)
Documentation=file:/usr/share/doc/hedronos-drivers/README.md
ConditionPathExists=!/etc/hedron/disable

[Service]
Type=simple
ExecStart=/usr/lib/hedron/driverd.py --serve
Restart=on-failure
RestartSec=3
User=root
Group=wheel
# Planning is read-only; only --apply (a separate path) writes, and it is not exposed
# over the socket. Keep the daemon maximally locked down.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @debug
CapabilityBoundingSet=
LockPersonality=yes
MemoryMax=256M
TasksMax=16

[Install]
Also=hedronos-driverd.socket
