# KDE global defaults for HedronOS.  SPDX-License-Identifier: MIT
[General]
ColorScheme=HedronOS
Name=HedronOS
XftAntialias=true
XftHintStyle=hintslight
XftSubPixel=rgb
TerminalApplication=konsole
shadeMenu=true

[WM]
ActiveFont=JetBrains Mono,11,-1,5,50,0,0,0,0,0
InactiveFont=JetBrains Mono,10,-1,5,50,0,0,0,0,0

[Icons]
Theme=breeze-dark
FallbackTheme=breeze

[KDE]
SingleClick=true
WidgetStyle=Breeze
Contrast=0.7

[Effects]
Fade=true
Slide=true
Magic Lamp=false

[Konqueror Frame]
StatusBar=hidden

[General]
# Qt6 reads this: the compositor's own auto-scaling double-scales fractional panels.
QT_AUTO_SCREEN_SCALE_FACTOR=0
QT_SCALE_FACTOR=1
