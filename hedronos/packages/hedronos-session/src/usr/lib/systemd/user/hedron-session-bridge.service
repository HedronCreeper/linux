# SPDX-License-Identifier: MIT
[Unit]
Description=HedronOS focus bridge (compositor → FlowState)
PartOf=graphical-session.target
After=graphical-session.target hedron-flowstate.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/hedron/hedron-session-bridge --watch
Restart=on-failure
RestartSec=3
# It reads one file in its own runtime dir and writes to one socket. That is the whole job.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=32M

[Install]
WantedBy=graphical-session.target
