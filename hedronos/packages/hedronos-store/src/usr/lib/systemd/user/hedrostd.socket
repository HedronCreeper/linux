# SPDX-License-Identifier: MIT
[Unit]
Description=HedronOS store socket (activates hedrostd on demand)
PartOf=graphical-session.target

[Socket]
ListenStream=%t/hedron/store/sock
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Service=hedrostd.service

[Install]
WantedBy=sockets.target graphical-session.target
